{
    "name": "crabphp/drop",
    "description": "Minimal, anonymous 24-hour file sharing on CrabPHP and private Cloudflare R2",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-pdo_sqlite": "*",
        "ext-mbstring": "*",
        "crabphp/framework": "^0.7.2",
        "crabphp/s3": "^0.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {"psr-4": {"App\\": "app/"}},
    "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "check": ["@test", "@php cua describe app"]
    },
    "config": {"sort-packages": true},
    "prefer-stable": true
}
