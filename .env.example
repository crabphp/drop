APP_URL=http://127.0.0.1:8080
APP_DEBUG=false
# Generate: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
APP_KEY=local-development-only
ADMIN_TOKEN=sample

R2_ACCOUNT_ID=
R2_BUCKET=drop
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Direct-to-R2 upload limits; 2 GB per file, 10 GiB total reserved space.
MAX_FILE_BYTES=2000000000
MAX_STORED_BYTES=10737418240
SERVER_ADDRESS=tcp://127.0.0.1:8080
SERVER_WORKERS=1
# DB_DATABASE defaults to storage/database.sqlite
